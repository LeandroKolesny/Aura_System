generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model activities {
  id          String       @id
  type        ActivityType
  title       String
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())
  userId      String
  users       users        @relation(fields: [userId], references: [id])
}

model app_notifications {
  id          String           @id
  message     String
  type        NotificationType @default(INFO)
  recipientId String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  companyId   String
  companies   companies        @relation(fields: [companyId], references: [id])
}

model appointments {
  id                String            @id
  date              DateTime
  durationMinutes   Int
  price             Decimal           @db.Decimal(10, 2)
  status            AppointmentStatus @default(SCHEDULED)
  notes             String?
  paid              Boolean           @default(false)
  roomId            Int?
  stockDeducted     Boolean           @default(false)
  signatureUrl      String?
  signatureMetadata Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  companyId         String
  patientId         String
  professionalId    String
  procedureId       String
  googleEventId     String?
  companies         companies         @relation(fields: [companyId], references: [id])
  patients          patients          @relation(fields: [patientId], references: [id])
  procedures        procedures        @relation(fields: [procedureId], references: [id])
  users             users             @relation(fields: [professionalId], references: [id])
  transactions      transactions[]

  @@index([companyId, date])
  @@index([companyId])
  @@index([companyId, professionalId, date])
  @@index([companyId, status])
  @@index([patientId])
}

model companies {
  id                    String                  @id
  name                  String
  slug                  String                  @unique
  logo                  String?
  address               String?
  cnpj                  String?
  presentation          String?
  phones                String[]                @default([])
  plan                  Plan                    @default(FREE)
  subscriptionStatus    SubscriptionStatus      @default(TRIAL)
  subscriptionExpiresAt DateTime?
  lastPlan              Plan?
  businessHours         Json?
  onlineBookingConfig   Json?
  layoutConfig          Json?
  paymentMethods        String[]                @default([])
  targetFemale          Boolean                 @default(true)
  targetMale            Boolean                 @default(true)
  targetKids            Boolean                 @default(false)
  website               String?
  facebook              String?
  instagram             String?
  onboardingCompleted   Boolean                 @default(false)
  isActive              Boolean                 @default(true)
  lastMarketingSentAt   DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  city                  String?
  state                 String?
  salesStatus           SalesStatus             @default(NEW)
  customPrice           Decimal?                @db.Decimal(10, 2)
  asaasCustomerId       String?
  asaasSubscriptionId   String?
  app_notifications     app_notifications[]
  appointments          appointments[]
  inventory_items       inventory_items[]
  leads                 leads[]
  patient_subscriptions patient_subscriptions[]
  patients              patients[]
  photo_records         photo_records[]
  procedures            procedures[]
  subscription_plans    subscription_plans[]
  tickets               tickets[]
  transactions          transactions[]
  unavailability_rules  unavailability_rules[]
  users                 users[]
}

model google_calendar_watches {
  id         String   @id
  channelId  String   @unique
  resourceId String?
  expiration DateTime
  userId     String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  users      users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model inventory_items {
  id                 String               @id
  name               String
  unit               String
  currentStock       Decimal              @db.Decimal(10, 2)
  minStock           Decimal              @default(5) @db.Decimal(10, 2)
  costPerUnit        Decimal              @db.Decimal(10, 2)
  lastRestockDate    DateTime?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  companyId          String
  companies          companies            @relation(fields: [companyId], references: [id])
  procedure_supplies procedure_supplies[]
  stock_movements    stock_movements[]

  @@index([companyId])
  @@index([companyId, isActive])
}

model leads {
  id           String     @id
  name         String
  email        String?
  phone        String?
  source       String?
  status       LeadStatus @default(NEW)
  notes        String?
  lastContact  DateTime?
  nextFollowUp DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  companyId    String
  assignedToId String?
  users        users?     @relation(fields: [assignedToId], references: [id])
  companies    companies  @relation(fields: [companyId], references: [id])
}

model notifications {
  id        String           @id
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  userId    String
  users     users            @relation(fields: [userId], references: [id])
}

model patient_subscriptions {
  id                    String                    @id
  status                PatientSubscriptionStatus @default(ACTIVE)
  startDate             DateTime                  @default(now())
  nextBillingDate       DateTime
  sessionsUsedThisCycle Json
  lastCycleReset        DateTime                  @default(now())
  asaasSubscriptionId   String?
  asaasCustomerId       String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime
  patientId             String
  planId                String
  companyId             String
  companies             companies                 @relation(fields: [companyId], references: [id])
  patients              patients                  @relation(fields: [patientId], references: [id])
  subscription_plans    subscription_plans        @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([patientId])
}

model patients {
  id                         String                  @id
  name                       String
  email                      String
  phone                      String
  birthDate                  DateTime?
  cpf                        String?
  status                     PatientStatus           @default(ACTIVE)
  anamnesisSummary           String?
  consentSignedAt            DateTime?
  consentSignatureUrl        String?
  consentMetadata            Json?
  anamnesisLinkSent          Boolean                 @default(false)
  lastMarketingMessageSentAt DateTime?
  lastVisit                  DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime
  companyId                  String
  appointments               appointments[]
  patient_subscriptions      patient_subscriptions[]
  companies                  companies               @relation(fields: [companyId], references: [id])
  photo_records              photo_records[]
  transactions               transactions[]

  @@unique([email, companyId])
  @@index([companyId, email])
  @@index([companyId])
  @@index([companyId, status])
}

model photo_records {
  id        String    @id
  date      DateTime
  url       String
  type      PhotoType
  procedure String
  groupId   String
  createdAt DateTime  @default(now())
  companyId String
  patientId String
  companies companies @relation(fields: [companyId], references: [id])
  patients  patients  @relation(fields: [patientId], references: [id])
}

model procedure_supplies {
  id              String          @id
  quantityUsed    Decimal         @db.Decimal(10, 2)
  procedureId     String
  inventoryItemId String
  inventory_items inventory_items @relation(fields: [inventoryItemId], references: [id])
  procedures      procedures      @relation(fields: [procedureId], references: [id], onDelete: Cascade)
}

model procedures {
  id                      String                    @id
  name                    String
  description             String?
  imageUrl                String?
  price                   Decimal                   @db.Decimal(10, 2)
  cost                    Decimal                   @default(0) @db.Decimal(10, 2)
  durationMinutes         Int                       @default(60)
  isActive                Boolean                   @default(true)
  maintenanceRequired     Boolean                   @default(false)
  maintenanceIntervalDays Int?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  companyId               String
  appointments            appointments[]
  procedure_supplies      procedure_supplies[]
  companies               companies                 @relation(fields: [companyId], references: [id])
  subscription_plan_items subscription_plan_items[]

  @@index([companyId])
  @@index([companyId, isActive])
}

model saas_plans {
  id               String   @id
  name             String   @unique
  price            Decimal  @db.Decimal(10, 2)
  features         String[] @default([])
  isActive         Boolean  @default(true)
  stripeProductId  String?
  stripePriceId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  displayName      String?
  maxPatients      Int      @default(50)
  maxProfessionals Int      @default(1)
  modules          String[] @default([])
}

model stock_movements {
  id              String            @id
  quantity        Decimal           @db.Decimal(10, 2)
  type            StockMovementType
  reason          String?
  createdAt       DateTime          @default(now())
  inventoryItemId String
  inventory_items inventory_items   @relation(fields: [inventoryItemId], references: [id])
}

model subscription_plan_items {
  id                 String             @id
  sessionsPerCycle   Int
  planId             String
  procedureId        String
  subscription_plans subscription_plans @relation(fields: [planId], references: [id], onDelete: Cascade)
  procedures         procedures         @relation(fields: [procedureId], references: [id])

  @@index([planId])
}

model subscription_plans {
  id                      String                    @id
  name                    String
  price                   Decimal                   @db.Decimal(10, 2)
  description             String?
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  companyId               String
  patient_subscriptions   patient_subscriptions[]
  subscription_plan_items subscription_plan_items[]
  companies               companies                 @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, isActive])
}

model system_alerts {
  id        String           @id
  title     String
  message   String
  type      NotificationType @default(INFO)
  target    String
  status    AlertStatus      @default(ACTIVE)
  createdAt DateTime         @default(now())
}

model system_settings {
  id                   String    @id @default("global")
  maintenanceMode      Boolean   @default(false)
  maintenanceMessage   String?
  maintenanceStartedAt DateTime?
  maintenanceStartedBy String?
  updatedAt            DateTime
}

model ticket_messages {
  id         String   @id
  content    String
  senderId   String
  senderName String
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())
  ticketId   String
  tickets    tickets  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model tickets {
  id              String            @id
  subject         String
  status          TicketStatus      @default(OPEN)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  companyId       String
  ticket_messages ticket_messages[]
  companies       companies         @relation(fields: [companyId], references: [id])
}

model transactions {
  id             String            @id
  date           DateTime
  description    String
  amount         Decimal           @db.Decimal(10, 2)
  type           TransactionType
  category       String
  status         TransactionStatus @default(PENDING)
  paymentMethod  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  companyId      String
  patientId      String?
  appointmentId  String?
  professionalId String?
  appointments   appointments?     @relation(fields: [appointmentId], references: [id])
  companies      companies         @relation(fields: [companyId], references: [id])
  patients       patients?         @relation(fields: [patientId], references: [id])
  users          users?            @relation(fields: [professionalId], references: [id])

  @@index([companyId, date])
  @@index([companyId])
  @@index([companyId, type, status, date])
  @@index([companyId, type, status])
}

model unavailability_rules {
  id              String    @id
  description     String?
  startTime       String
  endTime         String
  dates           String[]
  professionalIds String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  companyId       String
  companies       companies @relation(fields: [companyId], references: [id])
}

model users {
  id                      String                   @id
  email                   String                   @unique
  name                    String
  password                String
  avatar                  String?
  phone                   String?
  role                    UserRole                 @default(ESTHETICIAN)
  isActive                Boolean                  @default(true)
  emailVerified           DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime
  title                   String?
  contractType            ContractType             @default(PJ)
  remunerationType        RemunerationType         @default(COMMISSION)
  commissionRate          Decimal?                 @db.Decimal(5, 2)
  fixedSalary             Decimal?                 @db.Decimal(10, 2)
  businessHours           Json?
  companyId               String?
  googleId                String?                  @unique
  googleAccessToken       String?
  googleRefreshToken      String?
  googleCalendarId        String?
  googleCalendarConnected Boolean                  @default(false)
  googleTokenExpiresAt    DateTime?
  acceptedTermsAt         DateTime?
  acceptedTermsVersion    String?
  resetPasswordExpiry     DateTime?
  resetPasswordToken      String?                  @unique
  verificationToken       String?                  @unique
  verificationTokenExpiry DateTime?
  tokenVersion            Int                      @default(0)
  activities              activities[]
  appointments            appointments[]
  google_calendar_watches google_calendar_watches?
  leads                   leads[]
  notifications           notifications[]
  transactions            transactions[]
  companies               companies?               @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, role])
}

enum ActivityType {
  PATIENT_CREATED
  PATIENT_UPDATED
  CONSENT_SIGNED
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_COMPLETED
  APPOINTMENT_CANCELED
  PAYMENT_RECEIVED
  EXPENSE_CREATED
  STOCK_ADJUSTED
  STOCK_LOW_ALERT
  USER_LOGIN
  USER_LOGOUT
  SETTINGS_CHANGED
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  LEAD_ASSIGNED
}

enum AlertStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  PENDING_APPROVAL
}

enum ContractType {
  CLT
  PJ
  FREELANCER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum NotificationType {
  SUCCESS
  ERROR
  INFO
  WARNING
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  LEAD
}

enum PatientSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
  OVERDUE
}

enum PhotoType {
  BEFORE
  AFTER
}

enum Plan {
  FREE
  BASIC
  PROFESSIONAL
  PREMIUM
  ENTERPRISE
  STARTER
}

enum RemunerationType {
  FIXED
  COMMISSION
  MIXED
}

enum SalesStatus {
  NEW
  CONTACTED
  DEMO
  NEGOTIATION
  WON
  LOST
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  LOSS
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  OVERDUE
  CANCELED
}

enum TicketStatus {
  OPEN
  PENDING
  CLOSED
}

enum TransactionStatus {
  PAID
  PENDING
  OVERDUE
  REFUNDED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum UserRole {
  OWNER
  ADMIN
  RECEPTIONIST
  ESTHETICIAN
  PATIENT
}
