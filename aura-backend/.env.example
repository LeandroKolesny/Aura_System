# ===========================================
# AURA SYSTEM BACKEND - VARIÁVEIS DE AMBIENTE
# ===========================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o arquivo .env no git.

# --- DATABASE (Prisma + Supabase) ---
# Encontre em: Supabase Dashboard → Settings → Database → Connection string
# Use a URL com pgbouncer=true para conexões pooled (produção)
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL direta para migrações (sem pooler)
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- SUPABASE ---
# Encontre em: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://PROJECTREF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- AUTENTICAÇÃO JWT ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo 32 caracteres aleatórios
JWT_SECRET="generate-a-strong-random-secret-min-32-chars"

# --- GOOGLE OAUTH ---
# Crie em: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-backend.vercel.app/api/auth/google/callback"

# --- SESSION (OAuth state) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="generate-a-strong-random-secret-min-32-chars"

# --- FRONTEND ---
# URL do frontend sem barra no final
FRONTEND_URL="https://your-frontend.vercel.app"

# --- CRON JOBS (Vercel Cron) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel envia este valor automaticamente no header Authorization: Bearer <secret>
CRON_SECRET="generate-a-strong-random-secret-min-32-chars"

# --- IA (Google Gemini) ---
# Opcional — funcionalidades de IA ficam desabilitadas sem esta chave
# Crie em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# --- AMBIENTE ---
NODE_ENV="development"
