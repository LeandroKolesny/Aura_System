{
  "name": "copy-of-aura-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc",
    "deploy:frontend": "bash scripts/verify-ci-green.sh && npm run type-check && vercel --prod --yes",
    "deploy:backend": "npm --prefix aura-backend run deploy",
    "deploy:all": "npm run deploy:backend && npm run deploy:frontend",
    "test:unit": "vitest run && npm --prefix aura-backend run test:ci",
    "test:unit:frontend": "vitest run",
    "test:unit:frontend:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "bash test-all.sh",
    "test:all:unit": "bash test-all.sh --unit-only",
    "test:all:e2e": "bash test-all.sh --e2e-only",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@remotion/player": "^4.0.443",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "6.22.3",
    "react-router-dom": "6.22.3",
    "recharts": "2.12.7",
    "remotion": "^4.0.443",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
