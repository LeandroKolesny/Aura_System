{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // Adicionado após descobrir que @types/react nunca esteve instalado:
    // sem isso, todo o JSX/React virava `any` implícito e o tsc nunca
    // pegava — agora qualquer gap de tipagem futuro quebra o build na hora.
    "noImplicitAny": true
  },
  "exclude": [
    "node_modules",
    "aura-backend"
  ]
}